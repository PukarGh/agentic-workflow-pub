{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./hooks/set-workflow-env.sh" }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/commit-plan.sh",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/track-start.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./hooks/track-stop.sh",
        "timeout": 5
      }
    ]
  }
}
